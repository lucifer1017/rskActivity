{
  "name": "@rootstock-kits/activity",
  "version": "0.1.0",
  "description": "Activity-feed and notification toolkit for tracking BTC → Rootstock bridge transactions (Flyover + PowPeg).",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^1.5.0"
  },
  "license": "MIT"
}
